{
  "name": "keelio",
  "version": "0.0.0",
  "private": true,
  "description": "Risk-limited sBTC vaults for trading agents on Stacks",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/demo && tsc --noEmit -p apps/dashboard && tsc --noEmit -p apps/site",
    "test": "vitest run --reporter=default --reporter=json --outputFile.json=.cache/test-results.json",
    "test:online": "KEELIO_ONLINE=1 vitest run tests/bitflow-probe.test.ts tests/bitflow-adapter.test.ts tests/demo-bitflow.test.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run site:build && pnpm run site:test",
    "demo": "node --import ./scripts/resolve-ts.mjs scripts/demo.ts",
    "demo:bitflow": "node --import ./scripts/resolve-ts.mjs scripts/demo-bitflow.ts",
    "example:agent": "node --import ./scripts/resolve-ts.mjs examples/agent/run.ts",
    "monitor": "node --import ./scripts/resolve-ts.mjs scripts/monitor.ts",
    "demo:web": "vite apps/demo",
    "dashboard": "vite apps/dashboard",
    "check-deploy": "node --import ./scripts/resolve-ts.mjs scripts/check-deploy-config.ts",
    "site:build": "node --import ./scripts/resolve-ts.mjs apps/site/build.ts",
    "site:test": "vitest run --config apps/site/vitest.config.ts",
    "site:preview": "vite preview --outDir apps/site/dist",
    "web:build": "node --import ./scripts/resolve-ts.mjs scripts/build-web.ts",
    "web:preview": "node scripts/preview-web.mjs",
    "web:deploy": "pnpm run check && pnpm run web:build && wrangler pages deploy dist/web --project-name keelio --branch main"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stacks/clarinet-sdk": "4.0.0",
    "@stacks/clarinet-sdk-browser": "4.0.0",
    "@stacks/clarinet-sdk-wasm-browser": "4.0.0",
    "@stacks/transactions": "7.7.0",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.167.0"
  }
}
